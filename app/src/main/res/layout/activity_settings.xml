<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/background"
            app:title="Appearance &amp; Gestures"
            app:titleTextColor="@color/white"
            app:navigationIcon="@drawable/ic_lucide_arrow_left"
            app:navigationIconTint="@color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="40dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp">

            <!-- Floating Button Live Preview Hero Card (32dp squircle) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="@drawable/bg_squircle_hero"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LIVE PREVIEW"
                        android:textColor="#8E8E93"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Floating Button Preview View -->
                    <View
                        android:id="@+id/previewButton"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_apple_floating_button"
                        android:elevation="6dp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Section 1: Dimensions & Opacity -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="4dp"
                android:text="Dimensions &amp; Opacity"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <!-- Card with 28dp continuous squircle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_squircle_card"
                android:padding="20dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Button Size (dp)"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <!-- Rebuilt Capsule Slider for Button Size -->
                <com.example.assistivetouch.ui.view.CapsuleSliderView
                    android:id="@+id/capsuleSeekSize"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Idle Opacity"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <!-- Rebuilt Capsule Slider for Button Alpha -->
                <com.example.assistivetouch.ui.view.CapsuleSliderView
                    android:id="@+id/capsuleSeekAlpha"
                    android:layout_width="match_parent"
                    android:layout_height="44dp" />

            </LinearLayout>

            <!-- Section 2: Long-Press Gesture -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="4dp"
                android:text="Long-Press Gesture"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_squircle_card"
                android:padding="20dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Triggered action on hold"
                    android:textColor="#8E8E93"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <!-- Rebuilt Pill Segmented Radio Group -->
                <com.example.assistivetouch.ui.view.PillSegmentedGroup
                    android:id="@+id/pillGroupLongPress"
                    android:layout_width="match_parent"
                    android:layout_height="44dp" />
            </LinearLayout>

            <!-- Section 3: Visual Accent Color -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="4dp"
                android:text="Button Accent Palette"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_squircle_card"
                android:padding="20dp"
                android:layout_marginBottom="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Minimalist monochrome or colored theme"
                    android:textColor="#8E8E93"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <!-- Rebuilt Pill Segmented Radio Group -->
                <com.example.assistivetouch.ui.view.PillSegmentedGroup
                    android:id="@+id/pillGroupColor"
                    android:layout_width="match_parent"
                    android:layout_height="44dp" />
            </LinearLayout>

            <!-- Save & Apply Changes Pill Button -->
            <FrameLayout
                android:id="@+id/buttonApplySettings"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_pill_button_white"
                android:elevation="4dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Apply Changes"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
