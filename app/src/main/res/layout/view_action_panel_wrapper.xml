<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelBackdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#70000000"
    android:clickable="true"
    android:focusable="true">

    <!-- Luxury OLED Pitch Black Frosted Panel (0dp Sharp Brutalist Radius) -->
    <FrameLayout
        android:id="@+id/panelCard"
        android:layout_width="330dp"
        android:layout_height="330dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_apple_assistive_panel"
        android:elevation="24dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Page 1: Radial Menu (Main Actions & Favorites) -->
        <com.example.assistivetouch.ui.view.AssistiveRadialMenuView
            android:id="@+id/radialMenuView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <!-- Page 2: Controls View (Tactile Sliders + System Shortcuts) -->
        <LinearLayout
            android:id="@+id/layoutControlsView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="22dp"
            android:paddingVertical="18dp"
            android:visibility="gone">

            <!-- Controls Header: Title & Back Button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/controlsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="4dp"
                    android:text="Hardware Controls"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <LinearLayout
                    android:id="@+id/buttonControlsBack"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_pill_button"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_lucide_arrow_left"
                        android:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Back"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Quick Toggles Row (Wi-Fi, Bluetooth, Screenshot, Recents) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/controlWifi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/ripple_apple_item">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_lucide_wifi"
                        android:tint="@color/white" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wi-Fi"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/controlBluetooth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/ripple_apple_item">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_lucide_bluetooth"
                        android:tint="@color/white" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bluetooth"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/controlScreenshot"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/ripple_apple_item">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_lucide_camera"
                        android:tint="@color/white" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Capture"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/controlRecord"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/ripple_apple_item">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_lucide_layers"
                        android:tint="@color/white" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recents"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:layout_marginTop="3dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Rebuilt Tactile Volume Slider (0dp radius) -->
            <com.example.assistivetouch.ui.view.CapsuleSliderView
                android:id="@+id/capsuleVolumeSlider"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp" />

            <!-- Rebuilt Tactile Brightness Slider (0dp radius) -->
            <com.example.assistivetouch.ui.view.CapsuleSliderView
                android:id="@+id/capsuleBrightnessSlider"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
